{
  "name": "aud_midi_core",
  "summary": "Runtime of the aud_midi family: backend contracts, the MIDI engine with input/output pipelines, scheduling, port registry, diagnostics, composite and BLE-MIDI backends, fake backend for tests.",
  "domain": [
    "MidiBackend contract and sub-APIs, package clock, MidiException",
    "MidiEngine: parse/decode, JR timestamps, translation, bounded queues, software scheduler with lookahead, panic, hotplug",
    "FakeMidiBackend contract tests; no dart:io, dart:ffi, dart:isolate"
  ],
  "interfaces": {
    "uses": {
      "aud_midi_standard": "messages, models, MidiPacket, codecs, translators"
    },
    "usedBy": {
      "aud_midi": "hosts MidiEngine in the MIDI isolate, MidiCompositeBackend, re-exports",
      "aud_midi_network": "MidiBackend, MidiNetworkBackend, MidiServiceAdvertiser",
      "aud_midi_apple, aud_midi_android, aud_midi_windows, aud_midi_linux, aud_midi_web": "MidiBackend, MidiBackendHost, MidiClockMapper, FakeMidiBackend in tests",
      "aud_midi_linux": "MidiBleBluetoothBackend over a BlueZ MidiBleTransport"
    }
  }
}
